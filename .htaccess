# Apache: headers require mod_headers; compression requires mod_deflate.
# Production domain; keep ACME validation reachable for certificate renewal.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^arbcarbon\.pl$ [NC]
  RewriteRule ^ https://arbcarbon.pl%{REQUEST_URI} [R=301,L,NE]
</IfModule>
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-JtlAI6jmL5VWq82xPhxSK8U9tT5JWuxcZ3Ovqx1WnuI='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; worker-src 'none'; media-src 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header set Cache-Control "public, max-age=0, must-revalidate"
  <FilesMatch "\.(webp|svg)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

