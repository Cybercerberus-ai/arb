# Static hosts supporting the _headers format (e.g. Cloudflare Pages / Netlify).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Trd7UgHPKERcXGnVoPqwMzZuBrQgxlmTmUbFCEvS4eU='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; form-action 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; worker-src 'none'; media-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
